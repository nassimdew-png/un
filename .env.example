# ==============================================================================
# PsyPro Platform - Global Environment Configuration
# ==============================================================================

# Application Meta
APP_NAME=PsyPro
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost

# Subdomain / Domain Configurations
BASE_DOMAIN=psypro.local
SUPERADMIN_SUBDOMAIN=admin

# MongoDB Configuration
DB_CONNECTION=mongodb
DB_HOST=mongodb
DB_PORT=27017
DB_DATABASE=psypro_saas_db
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=secure_psypro_password

# JWT & Authentication
JWT_SECRET=generate_strong_secret_key_here_for_psypro_jwt
JWT_TTL=1440

# AI Microservice URL (FastAPI)
AI_SERVICE_URL=http://ai-service:8000
FASTAPI_PORT=8000

# LLM Providers Configuration (FastAPI Clinical Engine)
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Frontend Configuration
VITE_API_BASE_URL=http://api.psypro.local/api
VITE_AI_DIRECT_URL=http://ai.psypro.local

# Storage & File Uploads
FILESYSTEM_DISK=local
PDF_STORAGE_PATH=/storage/bilans

# Port Bindings for Local Development
TRAEFIK_HTTP_PORT=80
TRAEFIK_HTTPS_PORT=443
FRONTEND_DEV_PORT=3000
BACKEND_DEV_PORT=8000
