{
    "name": "psypro/backend-api",
    "type": "project",
    "description": "PsyPro Multi-tenant Clinical SaaS Backend API with MongoDB",
    "keywords": ["laravel", "mongodb", "orthophonie", "psychology", "saas", "multi-tenancy"],
    "license": "proprietary",
    "require": {
        "php": "^8.2",
        "mongodb/laravel-mongodb": "^4.0",
        "laravel/sanctum": "^3.3 || ^4.0",
        "guzzlehttp/guzzle": "^7.8"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "mockery/mockery": "^1.6",
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "audit": {
            "block": false
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
