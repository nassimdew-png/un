{
    "name": "psypro/backend-api",
    "type": "project",
    "description": "PsyPro Multi-tenant Clinical SaaS Backend API with MongoDB",
    "keywords": ["laravel", "mongodb", "orthophonie", "psychology", "saas", "multi-tenancy"],
    "license": "proprietary",
    "require": {
        "php": "^8.2",
        "laravel/framework": "^11.0",
        "mongodb/laravel-mongodb": "^4.0",
        "laravel/sanctum": "^4.0",
        "guzzlehttp/guzzle": "^7.8"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "platform-check": false,
        "platform": {
            "php": "8.3.6"
        },
        "audit": {
            "block": false
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
